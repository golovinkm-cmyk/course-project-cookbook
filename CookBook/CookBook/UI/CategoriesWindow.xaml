<Window x:Class="UI.CategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Title="CategoriesWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Новая категория:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="categoryNameTextBox" Width="200" 
                     Text="Новая категория" VerticalAlignment="Center"/>
            <Button Content="Добавить" Width="80" Height="30" Margin="10,0,0,0"
                    Click="AddCategoryButton_Click"/>
        </StackPanel>

        <!-- Список категорий -->
        <DataGrid Grid.Row="1" x:Name="categoriesDataGrid" 
                  AutoGenerateColumns="False" Margin="0,0,0,15"
                  SelectionMode="Single" SelectionChanged="CategoriesDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="300"/>
                <DataGridTextColumn Header="Дата создания" 
                       Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                <!-- RecipesCount нужно будет добавить как свойство в Domain.Category или создать ViewModel -->
            </DataGrid.Columns>

        </DataGrid>

        <!-- Панель редактирования -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Описание:" Width="80" VerticalAlignment="Center"/>
                <TextBox x:Name="descriptionTextBox" Width="400" 
                         Text="Описание категории"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить изменения" Width="150" Height="30"
                        Click="SaveChangesButton_Click"/>
                <Button Content="Удалить выбранную" Width="120" Height="30" Margin="10,0,0,0"
                        Click="DeleteCategoryButton_Click"/>
                <Button Content="Закрыть" Width="80" Height="30" Margin="10,0,0,0"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
