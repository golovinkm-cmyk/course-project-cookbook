<Window x:Class="UI.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Title="LicenseWindow" Height="450" Width="800">
    <TabControl>
        <!-- Вкладка покупки лицензии -->
        <TabItem Header="Купить лицензию">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Выбор типа лицензии -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Тип лицензии:" Width="120" VerticalAlignment="Center"/>
                        <ComboBox x:Name="licenseTypeComboBox" Width="200"
                                  SelectionChanged="LicenseTypeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Пожизненная"/>
                            <ComboBoxItem Content="Годовая"/>
                            <ComboBoxItem Content="Месячная"/>
                        </ComboBox>
                        <TextBlock x:Name="priceTextBlock" FontWeight="Bold" FontSize="16"
                                   Margin="20,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Информация о покупателе -->
                    <TextBlock Grid.Row="1" Text="Информация о покупателе:" 
                               FontWeight="Bold" Margin="0,0,0,5"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Имя:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="customerNameTextBox" Width="300"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Email:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="customerEmailTextBox" Width="300"/>
                    </StackPanel>

                    <!-- Данные банковской карты -->
                    <TextBlock Grid.Row="4" Text="Данные банковской карты:" 
                               FontWeight="Bold" Margin="0,0,0,5"/>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Номер карты:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="cardNumberTextBox" Width="200" MaxLength="19"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Срок действия:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="cardExpiryTextBox" Width="80" MaxLength="5" Text="MM/YY"/>
                        <TextBlock Text="CVV:" Margin="20,0,5,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="cardCvvTextBox" Width="60" MaxLength="3"/>
                    </StackPanel>

                    <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Имя владельца:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="cardHolderTextBox" Width="300"/>
                    </StackPanel>

                    <!-- Лицензионное соглашение -->
                    <StackPanel Grid.Row="8" Margin="0,0,0,10">
                        <TextBlock Text="Лицензионное соглашение:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Border BorderBrush="LightGray" BorderThickness="1" Height="100" Padding="5">
                            <ScrollViewer>
                                <TextBlock TextWrapping="Wrap">
                                    Приобретая лицензию, вы соглашаетесь с условиями использования программы "Персональная кулинарная книга".
                                    Лицензия предоставляет доступ ко всем функциям программы, включая неограниченное количество рецептов,
                                    отсутствие рекламы и доступ к премиум-контенту. Лицензия действует на одном устройстве.
                                </TextBlock>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Чекбокс согласия -->
                    <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,0,0,15">
                        <CheckBox x:Name="agreementCheckBox" Content="Я согласен с условиями лицензионного соглашения"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Пустое пространство -->
                    <Grid Grid.Row="10"/>

                    <!-- Кнопки -->
                    <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Купить" Width="100" Height="30" 
                                Click="BuyButton_Click" IsEnabled="{Binding ElementName=agreementCheckBox, Path=IsChecked}"/>
                        <Button Content="Отмена" Width="80" Height="30" Margin="10,0,0,0"
                                Click="CancelButton_Click"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- Вкладка активации по ключу -->
        <TabItem Header="Активировать ключ">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Поле для ввода ключа -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Введите лицензионный ключ:" Margin="0,0,0,5"/>
                    <TextBox x:Name="licenseKeyTextBox" Height="30" FontSize="14"
                             Text="XXXX-XXXX-XXXX-XXXX"/>
                </StackPanel>

                <!-- Информация о ключе -->
                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock Text="Информация о лицензии:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="licenseInfoTextBlock" Text="Ключ не активирован" Foreground="Gray"/>
                </StackPanel>

                <!-- Статус активации -->
                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <TextBlock Text="Статус:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="activationStatusTextBlock" Text="Ожидание ввода ключа"/>
                </StackPanel>

                <!-- Пустое пространство -->
                <Grid Grid.Row="3"/>

                <!-- Кнопки -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Активировать" Width="100" Height="30" 
                            Click="ActivateButton_Click"/>
                    <Button Content="Закрыть" Width="80" Height="30" Margin="10,0,0,0"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
