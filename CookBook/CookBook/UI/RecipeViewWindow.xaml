<Window x:Class="UI.RecipeViewWindow"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Title="RecipeViewWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и информация -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="titleTextBlock" FontSize="20" FontWeight="Bold" 
                       Text="Название рецепта" Margin="0,0,0,5"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Категория:" FontWeight="Bold"/>
                <TextBlock x:Name="categoryTextBlock" Text=" Основные блюда" Margin="5,0,20,0"/>

                <TextBlock Text="Сложность:" FontWeight="Bold"/>
                <TextBlock x:Name="difficultyTextBlock" Text=" Средний" Margin="5,0,20,0"/>

                <TextBlock Text="Время:" FontWeight="Bold"/>
                <TextBlock x:Name="timeTextBlock" Text=" 45 мин." Margin="5,0,20,0"/>

                <TextBlock Text="Порции:" FontWeight="Bold"/>
                <TextBlock x:Name="servingsTextBlock" Text=" 4" Margin="5,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Изображение и описание -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Изображение -->
            <Border Grid.Column="0" Width="200" Height="150" 
                    BorderBrush="LightGray" BorderThickness="1" Margin="0,0,15,0">
                <Image x:Name="recipeImage" Stretch="UniformToFill"/>
                <Border.Background>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <TextBlock Text="Нет изображения" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="Gray"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.Background>
            </Border>

            <!-- Описание -->
            <TextBlock Grid.Column="1" x:Name="descriptionTextBlock" 
                       TextWrapping="Wrap" Text="Описание рецепта будет здесь..."/>
        </Grid>

        <!-- Ингредиенты -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Ингредиенты:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DataGrid x:Name="ingredientsDataGrid" Height="150" 
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ингредиент" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                    <DataGridTextColumn Header="Единица" Binding="{Binding Unit}" Width="80"/>
                    <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Инструкция -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Инструкция приготовления:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="instructionsTextBox" TextWrapping="Wrap" 
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                     BorderThickness="0" Background="Transparent"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Редактировать" Width="100" Height="30" Click="EditButton_Click"/>
            <Button Content="Закрыть" Width="80" Height="30" Margin="10,0,0,0" Click="CloseButton_Click"/>
            <Button x:Name="buyButton" Content="Купить полную версию" Width="150" Height="30" 
                    Margin="20,0,0,0" Click="BuyButton_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
