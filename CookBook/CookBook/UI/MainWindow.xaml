<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="900">
    <Grid>
        <TabControl>
            <!-- Вкладка Рецепты -->
            <TabItem Header="Рецепты">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Панель поиска -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="searchTextBox" Width="200" 
                                 TextChanged="SearchTextBox_TextChanged"/>
                        <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                        <ComboBox x:Name="categoryComboBox" Width="150"
                                  SelectionChanged="CategoryComboBox_SelectionChanged"/>
                        <Button Content="Сбросить фильтры" Margin="20,0,0,0"
                                Click="ResetFiltersButton_Click"/>
                    </StackPanel>

                    <!-- Панель кнопок -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,5,10,10">
                        <Button Content="Добавить рецепт" Width="120" Height="30"
                                Click="AddRecipeButton_Click"/>
                        <Button Content="Редактировать" Width="100" Height="30" Margin="10,0,0,0"
                                Click="EditRecipeButton_Click"/>
                        <Button Content="Просмотреть" Width="100" Height="30" Margin="10,0,0,0"
                                Click="ViewRecipeButton_Click"/>
                        <Button Content="Удалить" Width="80" Height="30" Margin="10,0,0,0"
                                Click="DeleteRecipeButton_Click"/>
                        <Button Content="В избранное" Width="100" Height="30" Margin="10,0,0,0"
                                Click="ToggleFavoriteButton_Click"/>
                        <Button Content="Статистика" Width="100" Height="30" Margin="20,0,0,0"
                                Click="StatisticsButton_Click"/>
                    </StackPanel>

                    <!-- Список рецептов -->
                    <DataGrid Grid.Row="2" x:Name="recipesDataGrid" 
                              AutoGenerateColumns="False" Margin="10,0,10,10"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="200"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="120"/>
                            <DataGridTextColumn Header="Время" Binding="{Binding TotalTime}" Width="80"/>
                            <DataGridTextColumn Header="Порции" Binding="{Binding Servings}" Width="70"/>
                            <DataGridTextColumn Header="Сложность" Binding="{Binding DifficultyLevel}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Избранное" Binding="{Binding IsFavorite}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Премиум" Binding="{Binding IsPremium}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Статусная строка -->
                    <StatusBar Grid.Row="3">
                        <StatusBarItem>
                            <TextBlock x:Name="statusTextBlock" Text="Готово"/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <Separator/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <TextBlock x:Name="demoLimitTextBlock" Text="Доступно 5 рецептов" Foreground="Red"/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <Separator/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <Button Content="Купить полную версию" Click="BuyLicenseButton_Click"/>
                        </StatusBarItem>
                    </StatusBar>
                </Grid>
            </TabItem>

            <!-- Вкладка Категории -->
            <TabItem Header="Категории">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель управления категориями -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Добавить категорию" Width="130" Height="30"
                                Click="AddCategoryButton_Click"/>
                        <Button Content="Редактировать" Width="100" Height="30" Margin="10,0,0,0"
                                Click="EditCategoryButton_Click"/>
                        <Button Content="Удалить" Width="80" Height="30" Margin="10,0,0,0"
                                Click="DeleteCategoryButton_Click"/>
                    </StackPanel>

                    <!-- Список категорий -->
                    <DataGrid Grid.Row="1" x:Name="categoriesDataGrid" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="300"/>
                            <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Кол-во рецептов" Binding="{Binding RecipesCount}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
