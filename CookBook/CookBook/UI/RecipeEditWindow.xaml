<Window x:Class="UI.RecipeEditWindow"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Title="RecipeEditWindow" Height="700" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Название:" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="titleTextBox" Width="300" Text=""/>
        </StackPanel>

        <!-- Категория -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Категория:" Width="120" VerticalAlignment="Center"/>
            <ComboBox x:Name="categoryComboBox" Width="200">
                <ComboBoxItem Content="Завтраки"/>
                <ComboBoxItem Content="Основные блюда"/>
                <ComboBoxItem Content="Десерты"/>
                <ComboBoxItem Content="Закуски"/>
            </ComboBox>
        </StackPanel>

        <!-- Время приготовления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Время приготовления:" Width="120" VerticalAlignment="Center"/>
            <TextBlock Text="Подготовка:" Margin="10,0,5,0" VerticalAlignment="Center"/>
            <xctk:IntegerUpDown x:Name="preparationTimeUpDown" Width="80" Minimum="0" Maximum="480" Value="15"/>
            <TextBlock Text="мин." Margin="5,0,20,0" VerticalAlignment="Center"/>

            <TextBlock Text="Готовка:" VerticalAlignment="Center"/>
            <xctk:IntegerUpDown x:Name="cookingTimeUpDown" Width="80" Minimum="0" Maximum="480" Value="30" Margin="5,0,5,0"/>
            <TextBlock Text="мин." Margin="5,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Порции и сложность -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Количество порций:" Width="120" VerticalAlignment="Center"/>
            <xctk:IntegerUpDown x:Name="servingsUpDown" Width="80" Minimum="1" Maximum="20" Value="4"/>

            <TextBlock Text="Уровень сложности:" Margin="40,0,5,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="difficultyComboBox" Width="120" SelectedIndex="1">
                <ComboBoxItem Content="Легкий"/>
                <ComboBoxItem Content="Средний"/>
                <ComboBoxItem Content="Сложный"/>
            </ComboBox>
        </StackPanel>

        <!-- Описание -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Описание:" Margin="0,0,0,5"/>
            <TextBox x:Name="descriptionTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <!-- Ингредиенты -->
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Ингредиенты:" FontWeight="Bold"/>
                <Button Content="+" Width="25" Height="25" Margin="10,0,0,0" Click="AddIngredientButton_Click"/>
                <Button Content="-" Width="25" Height="25" Margin="5,0,0,0" Click="RemoveIngredientButton_Click"/>
            </StackPanel>

            <DataGrid x:Name="ingredientsDataGrid" Height="150" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ингредиент" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                    <DataGridTextColumn Header="Единица" Binding="{Binding Unit}" Width="80"/>
                    <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Инструкция приготовления -->
        <StackPanel Grid.Row="6" Margin="0,0,0,10">
            <TextBlock Text="Инструкция приготовления:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="instructionsTextBox" TextWrapping="Wrap" AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto" Height="150"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox x:Name="favoriteCheckBox" Content="В избранное" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <CheckBox x:Name="premiumCheckBox" Content="Премиум рецепт" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="Сохранить" Width="100" Height="30" Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="80" Height="30" Margin="10,0,0,0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
