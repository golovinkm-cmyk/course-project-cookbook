<Window x:Class="UI.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Title="StatisticsWindow" Height="700" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Статистика рецептов" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Фильтры -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="periodComboBox" Width="120" SelectionChanged="PeriodComboBox_SelectionChanged">
                <ComboBoxItem Content="За всё время" IsSelected="True"/>
                <ComboBoxItem Content="За месяц"/>
                <ComboBoxItem Content="За 3 месяца"/>
                <ComboBoxItem Content="За год"/>
            </ComboBox>

            <TextBlock Text="Тип статистики:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <ComboBox x:Name="statTypeComboBox" Width="150" SelectionChanged="StatTypeComboBox_SelectionChanged">
                <ComboBoxItem Content="По сложности"/>
                <ComboBoxItem Content="По категориям"/>
                <ComboBoxItem Content="По времени приготовления"/>
            </ComboBox>

            <Button Content="Обновить" Width="80" Height="30" Margin="20,0,0,0"
                    Click="RefreshButton_Click"/>
        </StackPanel>

        <!-- Диаграммы -->
        <TabControl Grid.Row="2">
            <!-- Круговая диаграмма -->
            <TabItem Header="Круговая диаграмма">
                <oxy:PlotView x:Name="pieChartView" Model="{Binding PieModel}" Margin="5"/>
            </TabItem>

            <!-- Столбчатая диаграмма -->
            <TabItem Header="Столбчатая диаграмма">
                <oxy:PlotView x:Name="barChartView" Model="{Binding BarModel}" Margin="5"/>
            </TabItem>

            <!-- Линейный график -->
            <TabItem Header="Линейный график">
                <oxy:PlotView x:Name="lineChartView" Model="{Binding LineModel}" Margin="5"/>
            </TabItem>

            <!-- Общая статистика -->
            <TabItem Header="Общая статистика">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Общая статистика:" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Всего рецептов:" 
                                       FontWeight="Bold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="totalRecipesText" Text="0" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="В избранном:" 
                                       FontWeight="Bold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="favoriteRecipesText" Text="0" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Премиум рецептов:" 
                                       FontWeight="Bold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="premiumRecipesText" Text="0" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Среднее время приготовления:" 
                                       FontWeight="Bold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="avgCookingTimeText" Text="0 мин." Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Самый популярный уровень сложности:" 
                                       FontWeight="Bold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="mostPopularDifficultyText" Text="-" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Самая популярная категория:" 
                                       FontWeight="Bold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="mostPopularCategoryText" Text="-" Margin="0,0,0,5"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
